<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="24dp" android:background="?android:attr/colorBackground">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
        <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="@string/brand" android:textAppearance="@style/Chalet.Eyebrow"/>
        <ImageButton android:id="@+id/logoutButton" style="@style/Chalet.IconButton" android:src="@drawable/logout" android:contentDescription="@string/logout_description"/>
    </LinearLayout>
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/admin_title" android:textAppearance="@style/Chalet.Title" android:layout_marginTop="16dp"/>
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/admin_subtitle" android:textAppearance="@style/Chalet.Subtitle" android:layout_marginTop="6dp"/>
    <com.google.android.material.textfield.TextInputLayout style="@style/Chalet.Input" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:hint="@string/search" app:startIconDrawable="@drawable/search">
        <com.google.android.material.textfield.TextInputEditText android:id="@+id/searchEditText" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="56dp" android:inputType="textCapWords"/>
    </com.google.android.material.textfield.TextInputLayout>
    <com.google.android.material.textfield.TextInputLayout android:id="@+id/dropdown_menu" style="@style/Chalet.Dropdown" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:hint="@string/selected_month" app:startIconDrawable="@drawable/calendar">
        <com.google.android.material.textfield.MaterialAutoCompleteTextView android:id="@+id/month" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="56dp" android:inputType="none"/>
    </com.google.android.material.textfield.TextInputLayout>
    <com.google.android.material.progressindicator.LinearProgressIndicator android:id="@+id/progress" android:layout_width="match_parent" android:layout_height="4dp" android:layout_marginTop="12dp" android:indeterminate="true" android:visibility="gone"/>
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/admin_section" android:textAppearance="@style/Chalet.Eyebrow" android:layout_marginTop="24dp"/>
    <TextView android:id="@+id/empty" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="24dp" android:text="@string/empty_employees" android:textAppearance="@style/Chalet.Subtitle" android:visibility="gone"/>
    <androidx.recyclerview.widget.RecyclerView android:id="@+id/recyclerView" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:layout_marginTop="12dp" android:clipToPadding="false" android:paddingBottom="16dp"/>
</LinearLayout>
