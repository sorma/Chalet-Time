<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true" android:background="?android:attr/colorBackground" android:clipToPadding="false">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="24dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
            <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="@string/brand" android:textAppearance="@style/Chalet.Eyebrow"/>
            <ImageButton android:id="@+id/logoutButton" style="@style/Chalet.IconButton" android:src="@drawable/logout" android:contentDescription="@string/logout_description"/>
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:orientation="vertical" android:padding="24dp" android:background="@drawable/hero_background">
            <ImageView android:layout_width="80dp" android:layout_height="60dp" android:src="@drawable/alpine_mark" app:tint="#DCE9DE" android:importantForAccessibility="no"/>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:text="@string/home_title" android:textSize="28sp" android:fontFamily="sans-serif-medium" android:textColor="#FFFFFF"/>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="@string/home_subtitle" android:textSize="15sp" android:textColor="#DCE9DE"/>
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp" android:layout_marginTop="24dp" android:background="@drawable/panel_background">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/home_section" android:textAppearance="@style/Chalet.Eyebrow"/>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/home_hint" android:textAppearance="@style/Chalet.Subtitle" android:layout_marginTop="8dp"/>
            <com.google.android.material.textfield.TextInputLayout android:id="@+id/date_input_layout" style="@style/Chalet.Input" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:hint="@string/select_date" app:startIconDrawable="@drawable/calendar" app:endIconMode="custom" app:endIconDrawable="@drawable/edit">
                <com.google.android.material.textfield.TextInputEditText android:id="@+id/date" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="56dp" android:focusable="false" android:focusableInTouchMode="false" android:inputType="none"/>
            </com.google.android.material.textfield.TextInputLayout>
            <com.google.android.material.textfield.TextInputLayout android:id="@+id/hourInputLayout" style="@style/Chalet.Input" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:hint="@string/insert_number_of_hours" app:startIconDrawable="@drawable/number" app:endIconMode="custom" app:endIconDrawable="@drawable/edit">
                <com.google.android.material.textfield.TextInputEditText android:id="@+id/hour" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="56dp" android:focusable="false" android:focusableInTouchMode="false" android:inputType="none"/>
            </com.google.android.material.textfield.TextInputLayout>
            <Button android:id="@+id/confrim_button" style="@style/Chalet.Button" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="@string/confirm"/>
            <com.google.android.material.progressindicator.LinearProgressIndicator android:id="@+id/progress" android:layout_width="match_parent" android:layout_height="4dp" android:layout_marginTop="12dp" android:indeterminate="true" android:visibility="gone"/>
        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
