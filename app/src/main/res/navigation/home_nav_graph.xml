<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/mobile_navigation"
    app:startDestination="@id/adminFragment">

    <fragment
        android:id="@+id/adminFragment"
        android:name="com.francesco.chalettime.AdminFragment"
        android:label="Admin"
        tools:layout="@layout/fragment_admin">
        <action
            android:id="@+id/action_adminFragment_to_userDetailsFragment"
            app:destination="@id/userDetailsFragment" />
    </fragment>

    <fragment
        android:id="@+id/userDetailsFragment"
        android:name="com.francesco.chalettime.UserDetailsFragment"
        android:label="Dettagli Utente"
        tools:layout="@layout/fragment_user_details">
        <action
            android:id="@+id/action_userDetailsFragment_to_adminFragment"
            app:destination="@id/adminFragment" />
    </fragment>

    <fragment
        android:id="@+id/homeFragment"
        android:name="com.francesco.chalettime.HomeFragment"
        android:label="Home"
        tools:layout="@layout/fragment_home"/>
</navigation>
